Description: Link against bz2 instead of bzip2 on Debian
 Debian's libbz2-dev provides libbz2.so, so the linker flag is -lbz2.
 Upstream hardcodes "bzip2" as the system library name, which does
 not exist on Debian.
Author: your-name <you@example.com>
Forwarded: no
Last-Update: 2026-10-28

---
diff --git a/src/build/SharedDeps.zig b/src/build/SharedDeps.zig
--- a/src/build/SharedDeps.zig
+++ b/src/build/SharedDeps.zig
@@ -242,7 +242,7 @@ pub fn add(
         );
 
         if (b.systemIntegrationOption("freetype", .{})) {
-            step.root_module.linkSystemLibrary("bzip2", dynamic_link_opts);
+            step.root_module.linkSystemLibrary("bz2", dynamic_link_opts);
             step.root_module.linkSystemLibrary("freetype2", dynamic_link_opts);
         } else {
             step.linkLibrary(freetype_dep.artifact("freetype"));
